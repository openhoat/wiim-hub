# Hub
PORT=8090
POLL_MS=3000

# The version written in the diagnostic report. The runtime image carries no
# package.json, so the deployment passes it (compose can use the tag).
# HUB_VERSION=0.7.0

# Comma separated device addresses, IP or resolvable hostname.
# The list is authoritative; discovery only enriches it.
DEVICE_HOSTS=192.168.1.10,192.168.1.11

# Name resolution, first answer wins: the pairs below, then the router's lease
# table, then the system resolver, then a built-in mDNS query.
# Static pairs, for a name whose address mDNS does not publish.
# DEVICE_STATIC_HOSTS=kitchen=192.168.1.10,studio=192.168.1.11
# A dnsmasq lease file the container may read (Pi-hole, OpenWrt, most routers).
# DEVICE_LEASES_FILE=/var/lib/misc/dnsmasq.leases

# SSDP discovery, best effort. Set 0 to disable.
DISCOVERY=1

# Alerts: one message when a diagnostic rule appears, never while it stays.
# Both channels can be set; each alert goes to both.
# NOTIFY_WEBHOOK=https://automation.example/hook/wiim
# NOTIFY_NTFY=https://ntfy.sh/my-wiim-hub
# NOTIFY_NTFY_TOKEN=
# Comma separated rule ids; empty means every rule.
# NOTIFY_RULES=offline,hardwareFault,flashWear
# info, warn or alert. The default already leaves the sleep timer and the drop
# counters out.
# NOTIFY_MIN_SEVERITY=warn
# How long a rule that cleared stays silent before it may speak again.
# NOTIFY_QUIET_MS=3600000

# UPnP events: the players push their changes instead of being polled for them.
# UPNP_CALLBACK is the base URL a speaker can reach this hub on, so keep it
# empty unless the hub and the speakers share a network. With events on, the
# playback fields arrive in under a second and the poll relaxes to SLOW_POLL_MS;
# the position, the counters, the group and the equalizer keep being polled.
# UPNP_CALLBACK=http://192.168.1.10:8091
# UPNP_PORT=8091
# SLOW_POLL_MS=15000
