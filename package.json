{
  "name": "wiim-hub",
  "version": "0.9.25",
  "private": true,
  "type": "module",
  "description": "Self-hosted hub for LinkPlay-based WiiM devices on the local network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/wiim-hub.git"
  },
  "homepage": "https://github.com/openhoat/wiim-hub#readme",
  "bugs": {
    "url": "https://github.com/openhoat/wiim-hub/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "docker",
    "hass",
    "linkplay",
    "mdns",
    "multiroom",
    "self-hosted",
    "wiim"
  ],
  "license": "MIT",
  "scripts": {
    "build": "wireit",
    "clean": "rm -rf dist .wireit docs/public/logo.svg",
    "demo": "node server/demo.ts",
    "docs:build": "wireit",
    "docs:dev": "npm run docs:logo && vitepress dev docs",
    "docs:logo": "wireit",
    "mcp": "node mcp/index.ts",
    "prepare": "husky",
    "qa": "wireit",
    "qa:biome": "wireit",
    "qa:biome:fix": "biome check --write --unsafe .",
    "qa:fix": "npm run qa:biome:fix && npm run qa:markdown:fix && npm run qa:prettier:fix",
    "qa:markdown": "wireit",
    "qa:markdown:fix": "markdownlint-cli2 --fix",
    "qa:prettier": "wireit",
    "qa:prettier:fix": "prettier --write \"**/*.md\"",
    "sonar": "wireit",
    "start": "node --env-file-if-exists=.env server/server.ts",
    "start:dev": "vite",
    "start:server": "node --env-file-if-exists=.env --watch server/server.ts",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:e2e": "playwright test",
    "typecheck": "wireit",
    "validate": "wireit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "11.17.2",
    "prettier": "3.9.10",
    "sonarqube-scanner": "5.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.1.0",
    "wireit": "0.15.0"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "src/**/*.{ts,tsx,css,json}",
        "index.html",
        "package.json",
        "public/**/*",
        "vite.config.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/app/**"
      ]
    },
    "docs:build": {
      "command": "vitepress build docs",
      "dependencies": [
        "docs:logo"
      ],
      "files": [
        "docs/**/*.md",
        "docs/.vitepress/config.mts",
        "docs/.vitepress/theme/**",
        "docs/img/logo.svg"
      ],
      "output": [
        "dist/docs/**"
      ]
    },
    "docs:logo": {
      "command": "mkdir -p docs/public && cp docs/img/logo.svg docs/public/logo.svg",
      "files": [
        "docs/img/logo.svg"
      ],
      "output": [
        "docs/public/logo.svg"
      ]
    },
    "qa": {
      "dependencies": [
        "qa:biome",
        "qa:markdown",
        "qa:prettier"
      ]
    },
    "qa:biome": {
      "command": "biome check .",
      "files": [
        "src/**/*.{ts,tsx,css,json}",
        "server/**/*.ts",
        "mcp/**/*.ts",
        "e2e/**/*.ts",
        "scripts/**/*",
        "*.ts",
        "*.mjs",
        "biome.json",
        "package.json",
        "docs/.vitepress/**/*.{ts,mts}",
        "public/sw.js"
      ],
      "output": []
    },
    "qa:markdown": {
      "command": "markdownlint-cli2",
      "files": [
        "**/*.md",
        "!node_modules",
        "!dist",
        "!coverage",
        "!test-results",
        "!playwright-report",
        ".markdownlint-cli2.yaml"
      ],
      "output": []
    },
    "qa:prettier": {
      "command": "prettier --check \"**/*.md\"",
      "files": [
        "**/*.md",
        "!node_modules",
        "!dist",
        "!coverage",
        "!test-results",
        "!playwright-report",
        ".prettierignore"
      ],
      "output": []
    },
    "sonar": {
      "command": "sonar-scanner-npm",
      "dependencies": [
        "test:coverage"
      ],
      "files": [
        "dist/coverage/lcov.info",
        "server/**/*.ts",
        "sonar-project.properties",
        "src/**/*"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:coverage"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "files": [
        "server/**/*.ts",
        "mcp/**/*.ts",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/coverage/**"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.{ts,tsx}",
        "server/**/*.ts",
        "mcp/**/*.ts",
        "e2e/**/*.ts",
        "*.ts",
        "tsconfig.json",
        "docs/.vitepress/**/*.{ts,mts}"
      ],
      "output": []
    },
    "validate": {
      "dependencies": [
        "build",
        "qa",
        "test:coverage",
        "typecheck"
      ]
    }
  }
}
