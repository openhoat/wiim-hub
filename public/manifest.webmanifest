{
  "name": "WiiM Hub",
  "short_name": "WiiM Hub",
  "description": "Self-hosted hub for WiiM devices and other LinkPlay-based players",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f6f2",
  "theme_color": "#26894c",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
